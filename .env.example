# ---------------------------------------------------------------------------
# Public (exposed to the browser)
# ---------------------------------------------------------------------------
# Final campaign URL. Used for share links, canonical URLs and OG images.
# Inlined at BUILD time: changing it needs a rebuild. On Vercel, when unset, the
# build falls back to the production domain (VERCEL_PROJECT_PRODUCTION_URL) for
# production and to the deployment URL (VERCEL_URL) for previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The Chefz gifts page (or app deep link). UTM params are appended automatically.
NEXT_PUBLIC_GIFT_URL=https://thechefz.co/
NEXT_PUBLIC_BRAND_URL=https://thechefz.co/
NEXT_PUBLIC_HASHTAG=#شكرا_معلمي
# Optional Google Tag Manager container (events are pushed to window.dataLayer).
NEXT_PUBLIC_GTM_ID=

# ---------------------------------------------------------------------------
# Server only
# ---------------------------------------------------------------------------
# Postgres connection string (Supabase / Neon / Vercel Postgres / RDS…).
# POSTGRES_URL (what the Vercel storage integrations inject) is used when this is empty.
# On Vercel / serverless use the provider's POOLED url — Supabase: the transaction
# pooler on port 6543; Neon: the "-pooler" host — every function instance opens
# its own small pool, and a direct URL runs out of connections under a spike.
# Leave empty to use the local JSON file store in .data/ (development only). On
# Vercel with no database, letters CANNOT be saved: writes return 503 (see
# ALLOW_FILE_STORE below for a throwaway demo).
DATABASE_URL=
# Optional direct (non-pooled) URL for `npm run db:schema` (DDL). Run it on every
# deploy, before traffic (e.g. in the build command: `npm run db:schema && next build`).
DATABASE_URL_UNPOOLED=
# Connections per instance (default 2 on serverless, 5 otherwise).
PG_POOL_MAX=

# Salt for hashing IPs / voter ids. Any long random string.
IP_HASH_SALT=change-me-to-a-long-random-string

# Client IP for rate limits / one-like-per-IP / report dedupe. Proxies APPEND to
# X-Forwarded-For, so only the entries our own proxies added can be trusted:
#   TRUSTED_PROXY_HOPS = how many proxies in front of the app append to it
#   (1 = Vercel, or one nginx / load balancer; 2 = CDN + load balancer; 0 = none,
#   the app is exposed directly and no header is trusted). On Vercel its own
#   x-vercel-forwarded-for / x-real-ip are used first.
TRUSTED_PROXY_HOPS=1
# Or name the ONE header your edge sets and overwrites, e.g. cf-connecting-ip
# behind Cloudflare, or x-real-ip set by your nginx. Takes precedence.
CLIENT_IP_HEADER=

# Bearer token for /admin (moderation dashboard). Leave empty to disable admin.
ADMIN_TOKEN=

# A letter moves to the review queue (hidden) after this many distinct
# "inappropriate/other" reports. A removal request by the person named hides it
# immediately.
REPORT_HIDE_THRESHOLD=3

# Human review:
#   auto              publish everything that passes the filter
#   review_suspicious publish clean letters, queue anything the filter isn't sure about (default)
#   review_all        every letter waits for approval in /admin
MODERATION_MODE=review_suspicious

# Letters per device per 24h (per-IP caps of 15/day and 5/10min also apply).
# Set to 1 for "one letter a day".
SUBMIT_LIMIT_PER_DAY=3

# Optional second moderation layer using Claude (catches insults / attacks the
# word list can't). Without a key only the word list runs.
ANTHROPIC_API_KEY=
# auto = use AI when a key is set; off = word list only;
# required = reject submissions if the AI check can't run.
MODERATION_AI=auto
# Optional model override for the AI check (default: claude-haiku-4-5).
MODERATION_AI_MODEL=

# Local file store (used when DATABASE_URL is empty — development only).
DATA_DIR=.data
# Seed the local file store with demo letters when it is empty. On Vercel this
# also opts in to the per-instance /tmp demo store (data is lost on scale-down).
SEED_DEMO=true
# Allow the /tmp file store on Vercel without demo letters (throwaway demos only).
ALLOW_FILE_STORE=

# Per-instance cache (ms) for the default wall, the counter and single letters,
# so a viral spike costs ~1 query per TTL per instance. 0 disables. Default 5000.
READ_CACHE_TTL_MS=

# Optional: a THROWAWAY Postgres database for the store integration test
# (the test drops and recreates the tables).
TEST_DATABASE_URL=
