# ---------------------------------------------------------------------------
# Public (exposed to the browser)
# ---------------------------------------------------------------------------
# Final campaign URL. Used for share links + OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The Chefz gifts page (or app deep link). UTM params are appended automatically.
NEXT_PUBLIC_GIFT_URL=https://thechefz.co/
NEXT_PUBLIC_BRAND_URL=https://thechefz.co/
NEXT_PUBLIC_HASHTAG=#شكرا_معلمي
# Optional Google Tag Manager container (events are pushed to window.dataLayer).
NEXT_PUBLIC_GTM_ID=

# ---------------------------------------------------------------------------
# Server only
# ---------------------------------------------------------------------------
# Postgres connection string (Supabase / Neon / Vercel Postgres / RDS…).
# Leave empty to use the local JSON file store in .data/ (development only).
DATABASE_URL=

# Salt for hashing IPs / voter ids. Any long random string.
IP_HASH_SALT=change-me-to-a-long-random-string

# Bearer token for /admin (moderation dashboard). Leave empty to disable admin.
ADMIN_TOKEN=

# A letter moves to the review queue (hidden) after this many distinct
# "inappropriate/other" reports. A removal request by the person named hides it
# immediately.
REPORT_HIDE_THRESHOLD=3

# Human review:
#   auto              publish everything that passes the filter
#   review_suspicious publish clean letters, queue anything the filter isn't sure about (default)
#   review_all        every letter waits for approval in /admin
MODERATION_MODE=review_suspicious

# Letters per device per 24h (per-IP caps of 15/day and 5/10min also apply).
# Set to 1 for "one letter a day".
SUBMIT_LIMIT_PER_DAY=3

# Optional second moderation layer using Claude (catches insults / attacks the
# word list can't). Without a key only the word list runs.
ANTHROPIC_API_KEY=
# auto = use AI when a key is set; off = word list only;
# required = reject submissions if the AI check can't run.
MODERATION_AI=auto
# Optional model override for the AI check (default: claude-haiku-4-5).
MODERATION_AI_MODEL=

# Local file store (used when DATABASE_URL is empty — development only).
DATA_DIR=.data
# Seed the local file store with demo letters when it is empty.
SEED_DEMO=true

# Optional: a THROWAWAY Postgres database for the store integration test
# (the test drops and recreates the tables).
TEST_DATABASE_URL=
